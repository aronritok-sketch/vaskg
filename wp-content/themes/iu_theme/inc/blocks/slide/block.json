{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 3,
	"title": "Slide",
	"name": "iu/slide",
	"description": "Display a slide element.",
	"parent": [ "iu/slider", "iu/content-slider" ], 
	"category": "theme",
	"attributes": {
		"bgColor": {
			"type": "string",
			"default": ""
		},
		"bgGradient": {
			"type": "string",
			"default": null
		},
		"bgImage": {
			"type": "string",
			"default": ""
		},
		"bgImageThumb": {
			"type": "string",
			"default": ""
		},
		"bgImageSize": {
			"type": "string",
			"default": "cover"
		},
		"bgImagePosition": {
			"type": "string",
			"default": "center"
		}
	},
	"editorScript": "file:./block.js",
	"style": "file:./style.css"
}